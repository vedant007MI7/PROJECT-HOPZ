PORT=3000
NODE_ENV=development
# Neon connection string (keep ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
PIN_MAX_ATTEMPTS=5
NEARBY_RADIUS_KM=5
# Password reset by phone: 'log' (default) prints the code in the server log; plug a real SMS provider into wrapper/sms.js
SMS_PROVIDER=log
# Password reset by email (Brevo, free plan: brevo.com > SMTP & API > API keys; MAIL_FROM must be a verified sender)
BREVO_API_KEY=
MAIL_FROM=
# Razorpay TEST keys (dashboard > Account & Settings > API Keys, in Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: tests use this instead of DATABASE_URL (use a separate Neon branch)
TEST_DATABASE_URL=
# Redis (Upstash, free plan) for driver locations. Optional: without it the app uses the database only.
REDIS_URL=
# Background jobs (BullMQ, needs REDIS_URL): password-reset emails/SMS and ride expiry run in a queue. Off by default.
QUEUE_ENABLED=
# Several server instances: share Socket.IO messages through Redis (also needs: npm install @socket.io/redis-adapter)
SOCKET_REDIS_ADAPTER=
# Dispatch in waves (nearest 3 drivers first, more every 15 s) and surge pricing (off unless true)
DISPATCH_WAVE_SIZE=3
SURGE_ENABLED=
# Database connections per server process (see docs/scaling.md)
PG_POOL_MAX=10
