# Copy this file to .env and fill it in. After changing it, restart with: npx expo start -c
# Your backend address, ending in /api
EXPO_PUBLIC_API_URL=https://your-service.onrender.com/api
# Ola Maps API key (destination search)
EXPO_PUBLIC_OLA_MAPS_KEY=
# Stadia Maps API key (optional): turns the map full black. Free key at https://client.stadiamaps.com, leave it out for the white map
EXPO_PUBLIC_STADIA_KEY=
